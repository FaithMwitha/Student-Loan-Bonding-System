{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/loans": [
        "./libs/loans/src"
      ],
      "@app/loans/*": [
        "./libs/loans/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/loans-bonding/tsconfig.app.json"
    },
    {
      "path": "./apps/api/tsconfig.app.json"
    }
  ]
}