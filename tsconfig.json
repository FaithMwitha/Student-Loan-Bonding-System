{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/auth": [
        "./libs/auth/src"
      ],
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/loans": [
        "./libs/loans/src"
      ],
      "@app/notifications": [
        "./libs/notifications/src"
      ],
      "@app/notifications/*": [
        "./libs/notifications/src/*"
      ],
      "@app/users": [
        "./libs/users/src"
      ]
    }
  },
  "files": [],
  "include": [
    "apps/**/*",
    "libs/**/*"
  ],
  "references": [
    {
      "path": "./apps/api/tsconfig.app.json"
    }
  ]
}