{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/common$": "<rootDir>/../../../libs/common/src",
    "^@app/loans$": "<rootDir>/../../../libs/loans/src",
    "^@app/users$": "<rootDir>/../../../libs/users/src",
    "^@app/auth$": "<rootDir>/../../../libs/auth/src",
    "^@app/profile$": "<rootDir>/../../../libs/profiles/src"
  }
}
